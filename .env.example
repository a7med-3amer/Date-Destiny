# ==================================================
# Date & Destiny - Environment Variables Configuration
# ==================================================

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/date_and_destiny
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/date_and_destiny?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/date_and_destiny

# App Base URL (used for metadata, OpenGraph tags, canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
